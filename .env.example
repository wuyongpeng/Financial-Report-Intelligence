# Change these two values before exposing the VM to a network.
POSTGRES_DB=financial_report
POSTGRES_USER=finance_app
POSTGRES_PASSWORD=replace-with-a-long-random-password

# Used only when running npm commands directly on the host. Docker Compose supplies its own host name.
DATABASE_URL=postgresql://finance_app:replace-with-a-long-random-password@127.0.0.1:5432/financial_report
# Host directory for Postgres, PDFs, and Caddy state (relative to the compose file, or absolute).
# On a VM with a large data disk: DATA_DIR=/data/financial-report
DATA_DIR=./data
# Path *inside* the app/worker containers. Keep this as /data/reports; compose bind-mounts DATA_DIR/reports there.
REPORTS_DIR=/data/reports
# Shared runtime state between app and worker (ingest switch, settings, progress, LLM gate).
RUNTIME_DIR=/app/.data
INTERNAL_INGEST_TOKEN=replace-with-a-long-random-token
# Application login. These credentials protect the Web UI and all report APIs.
APP_USERNAME=replace-with-login-username
APP_PASSWORD=replace-with-a-long-random-login-password
APP_SESSION_SECRET=replace-with-at-least-24-random-characters
# Competition/demo deployments can offer a one-click read-only evaluator entry.
# Keep false for private production deployments.
APP_DEMO_ACCESS=true
ADMIN_PASSWORD=replace-with-a-long-random-admin-password
ADMIN_SESSION_SECRET=replace-with-at-least-24-random-characters
# Set false only during private IP/HTTP verification. Set true with a public HTTPS domain.
COOKIE_SECURE=false

# Set to a real DNS name after its A/AAAA record points to this VM. Keep :80 for IP-based HTTP testing.
DOMAIN=:80
# Optional generic JSON webhook for worker/source failures (for example an internal alert relay).
ALERT_WEBHOOK_URL=
# Optional OpenAI-compatible model endpoint. Without it, chat returns original-PDF evidence only.
# Single provider (legacy, still supported):
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_MAX_TOKENS=1600
LLM_TIMEOUT_MS=60000
# Same endpoint, extra models tried in order after LLM_MODEL. Comma-separated, no JSON.
LLM_MODELS=thudm/glm-5.2,minimax/MiniMax-M2.7-highspeed,thudm/glm-5.1
# Ordered fallbacks to a different vendor. JSON array of OpenAI-compatible endpoints.
# LLM_PROVIDERS=[{"name":"openai","baseUrl":"https://api.openai.com/v1","apiKey":"sk-...","model":"gpt-4o-mini"}]
LLM_PROVIDERS=
# Optional: cap wait time on a failing non-last provider before switching. Unset = use LLM_TIMEOUT_MS.
# LLM_FAILOVER_TIMEOUT_MS=20000

# Gentle incremental scheduler (anti-ban). The crawl page settings drawer can override these at runtime.
# Worker scans new filings on pollIntervalMin (default 2 minutes, 1–60). INGEST_INTERVAL_MS is unused once saved.
INGEST_INTERVAL_MS=120000
INGEST_DAYS=2
INGEST_DOWNLOAD_LIMIT=2
INGEST_PARSE_LIMIT=1
INGEST_MAX_PAGES=8
PAGE_PAUSE_MS=1000
DOWNLOAD_PAUSE_MS=20000
