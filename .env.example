# Change these two values before exposing the VM to a network.
POSTGRES_DB=financial_report
POSTGRES_USER=finance_app
POSTGRES_PASSWORD=replace-with-a-long-random-password

# Used only when running npm commands directly on the host. Docker Compose supplies its own host name.
DATABASE_URL=postgresql://finance_app:replace-with-a-long-random-password@127.0.0.1:5432/financial_report
REPORTS_DIR=/data/reports
INTERNAL_INGEST_TOKEN=replace-with-a-long-random-token
# Application login. These credentials protect the Web UI and all report APIs.
APP_USERNAME=replace-with-login-username
APP_PASSWORD=replace-with-a-long-random-login-password
APP_SESSION_SECRET=replace-with-at-least-24-random-characters
# Competition/demo deployments can offer a one-click read-only evaluator entry.
# Keep false for private production deployments.
APP_DEMO_ACCESS=true
ADMIN_PASSWORD=replace-with-a-long-random-admin-password
ADMIN_SESSION_SECRET=replace-with-at-least-24-random-characters
# Set false only during private IP/HTTP verification. Set true with a public HTTPS domain.
COOKIE_SECURE=false

# Set to a real DNS name after its A/AAAA record points to this VM. Keep :80 for IP-based HTTP testing.
DOMAIN=:80
# Optional generic JSON webhook for worker/source failures (for example an internal alert relay).
ALERT_WEBHOOK_URL=
# Optional OpenAI-compatible model endpoint. Without it, chat returns original-PDF evidence only.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_MAX_TOKENS=1600
LLM_TIMEOUT_MS=60000

# Ten-minute incremental scheduler and deliberately conservative download/parse batches.
INGEST_INTERVAL_MS=600000
INGEST_DAYS=2
INGEST_DOWNLOAD_LIMIT=5
INGEST_PARSE_LIMIT=3
